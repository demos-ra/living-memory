{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "living-memory",
            "args": [
              "${user_config.data_dir}/anthropic/claude_code/raw_api_bodies"
            ],
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo",
            "args": [
              "Claude Code's past conversations are kept as MTSV in ${user_config.data_dir}/anthropic/claude_code/raw_api_bodies.mtsv, written after each response."
            ]
          }
        ]
      }
    ]
  }
}
